# Public frontend configuration for Exam Cracker.
# NEXT_PUBLIC_* values are browser-visible; do not put private service-account
# JSON, Firebase Admin credentials, or Cloudflare API tokens in this file.
# Local development uses these values automatically via npm run dev; override
# them in .env.local when intentionally testing another project.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyA1fiEviIdG5_yi7AcyxC3m9sec-AdkOfU
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=darvo1.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=darvo1
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=darvo1.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=283467136948
NEXT_PUBLIC_FIREBASE_APP_ID=1:283467136948:web:c66fd594827909eb3f7ce1
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-FMV79YMHBC

# Application data is served through the same-origin Cloudflare Worker and its D1 binding.
# Google Drive credentials are Worker secrets only (see GOOGLE_DRIVE_SETUP.md):
#   npx wrangler secret put GOOGLE_SERVICE_ACCOUNT_JSON --name exam-cracker-web
#   printf "1sSYE5cAY6jjAgzOYTgCQNOR1xxotc_I8" | npx wrangler secret put GOOGLE_DRIVE_FOLDER_ID --name exam-cracker-web
# Share Drive folder 1sSYE5cAY6jjAgzOYTgCQNOR1xxotc_I8 with the service account client_email as Editor.
# Never add secret values here or to any NEXT_PUBLIC_* variable.

# Existing Cloudflare YouTube metadata Worker (no YouTube Data API key needed)
NEXT_PUBLIC_CLOUDFLARE_MEDIA_PROXY_URL=https://ec-content-api.arvinddara0290.workers.dev

# UI hint only; the signed Firebase ID token is checked again by the backend
NEXT_PUBLIC_ADMIN_EMAIL=arvinddarabishnoi@gmail.com
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
NEXT_PUBLIC_SITE_URL=https://examcrack.pages.dev

# Optional public Firebase Web Push VAPID key from Console; leave empty until configured
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
