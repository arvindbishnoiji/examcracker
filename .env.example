# Browser-visible Firebase Web App config (Firebase Console → Project settings)
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Application data is served through the same-origin Cloudflare Worker and its D1 binding.
# No Supabase project is used. Google Drive credentials are Worker secrets only:
#   wrangler secret put GOOGLE_SERVICE_ACCOUNT_JSON
#   wrangler secret put GOOGLE_DRIVE_FOLDER_ID
# Never add those values here or to any NEXT_PUBLIC_* variable.

# Existing Cloudflare YouTube metadata Worker (no YouTube Data API key needed)
NEXT_PUBLIC_CLOUDFLARE_MEDIA_PROXY_URL=https://your-media-proxy.workers.dev

# UI hint only; the signed Firebase ID token is checked again by the backend
NEXT_PUBLIC_ADMIN_EMAIL=arvinddarabishnoi@gmail.com
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
NEXT_PUBLIC_SITE_URL=https://your-site.example

# Optional public Firebase Web Push VAPID key from Console; leave empty until configured
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
